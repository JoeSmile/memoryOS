# 应用
APP_NAME=MemoryOS API
ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# CORS（逗号分隔，不要空格）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL（先 cd infra/docker && docker compose up -d）
DATABASE_URL=postgresql+asyncpg://memoryos:memoryos@localhost:5432/memoryos
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis（先 pnpm db:up；删除或留空则禁用缓存）
REDIS_URL=redis://localhost:6379/0

# JWT（Story 3.4 — 生产务必换成长随机串，建议 ≥32 字符）
JWT_SECRET=change-me-in-production-use-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# EP02 LangGraph + EP04 RAG — LLM / Embedding（留空 OPENAI_API_KEY → mock，Harness 无需外网）
#
# Profile A — CLOUD 百炼（默认；地域须与 API Key 一致）
#   北京: https://dashscope.aliyuncs.com/compatible-mode/v1
#   新加坡: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen-turbo
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
# EMBEDDING_BASE_URL=  # 留空则与 OPENAI_BASE_URL 相同

# Profile B — LOCAL Ollama（宿主机 dev：先 ollama pull qwen3:8b mxbai-embed-large）
# 注释 Profile A 并启用下列；OPENAI_API_KEY=ollama 启用 live（非 mock）
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen3:8b
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDING_MODEL=mxbai-embed-large
# EMBEDDING_DIMENSIONS=1024
#
# 容器化全栈见 infra/docker/.env.deployment.example（Compose 用 host.docker.internal）

# EP04 RAG Chat — LangGraph retrieve before generation (ep04-rag-chat)
RAG_CHAT_ENABLED=true
RAG_CHAT_TOP_K=5
RAG_CHAT_MIN_SCORE=0.35
# 留空 = 全库检索；示例：RAG_CHAT_COLLECTION=worldcup-matches
RAG_CHAT_COLLECTION=

# EP02 LangSmith（可选；本地 dev 建议单独 project，勿提交真实 key）
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=memoryOS-dev

# EP05 Agent ReAct — Tavily web search tool (留空 TAVILY_API_KEY 则 mock)
AGENT_TOOLS_ENABLED=true
AGENT_MAX_ITERATIONS=5
AGENT_TOOL_TIMEOUT_SECONDS=10
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=3

# EP06 Memory — long-term retrieval (load_user_memories)
MEMORY_ENABLED=true
MEMORY_SHORT_TERM_ENABLED=true
MEMORY_LONG_TERM_ENABLED=true
MEMORY_LONG_TERM_TOP_K=5
MEMORY_MIN_SCORE=0.35
MEMORY_PRUNE_THRESHOLD=0.1
MAX_CONTEXT_TOKENS=8192
RESERVE_FOR_REPLY=1024
SUMMARY_TRIGGER_TOKENS=4096
SUMMARY_INCREMENT_TOKENS=1024
SUMMARY_COOLDOWN_SECONDS=300

# EP09 Chat security (Story 9.1) — API 侧
# CHAT_MAX_CONTENT_CHARS=200
# PROMPT_INJECTION_FILTER_ENABLED=true
# RAG_CHUNK_MAX_CHARS=8000
# LLM_GUARD_ENABLED=false
# LLM_GUARD_PROMPT_INJECTION_THRESHOLD=0.5
# LLM_INJECTION_GUARD_ENABLED=false
# ENTROPYSHIELD_ENABLED=false
# 开启后仅对低信任来源 DeSyntax：Tavily(web_search)、crawler-*、user-upload-*；worldcup-* ETL 不受影响
# 启用时需: pip install entropyshield
# 启用 LLM Guard 时需: pip install llm-guard
# BFF 侧见 apps/web/.env.example（BFF_PROMPT_GUARD_*）
