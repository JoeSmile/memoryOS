# 应用
APP_NAME=MemoryOS API
ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# CORS（逗号分隔，不要空格）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL（先 cd infra/docker && docker compose up -d）
DATABASE_URL=postgresql+asyncpg://memoryos:memoryos@localhost:5432/memoryos
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis（先 pnpm db:up；删除或留空则禁用缓存）
REDIS_URL=redis://localhost:6379/0

# JWT（Story 3.4 — 生产务必换成长随机串，建议 ≥32 字符）
JWT_SECRET=change-me-in-production-use-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# EP02 LangGraph — 百炼 OpenAI 兼容（留空 OPENAI_API_KEY 则 mock，Harness 无需外网）
OPENAI_API_KEY=
OPENAI_MODEL=qwen-turbo
# 地域须与 API Key 一致：北京见下；新加坡用 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# EP04 RAG — 与 rag_constants / migration vector(1024) 一致
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# EP04 RAG Chat — LangGraph retrieve before generation (ep04-rag-chat)
RAG_CHAT_ENABLED=true
RAG_CHAT_TOP_K=5
RAG_CHAT_MIN_SCORE=0.35
# 留空 = 全库检索；示例：RAG_CHAT_COLLECTION=worldcup-matches
RAG_CHAT_COLLECTION=

# EP02 LangSmith（可选；本地 dev 建议单独 project，勿提交真实 key）
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=memoryOS-dev
