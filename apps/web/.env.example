# Backend API base URL for browser (no trailing slash). Must match Nginx/public origin.
# Rebuild web image after changing (NEXT_PUBLIC_* is baked at build time).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side only: BFF → FastAPI (Docker full profile). Unset for pnpm dev on host.
# API_UPSTREAM_URL=http://api:8000

# App display name (optional override)
# NEXT_PUBLIC_APP_NAME=MemoryOS

# Dev vitals: default alerts only "poor"; set 1 to include needs-improvement + all metrics in console
# NEXT_PUBLIC_WEB_VITALS_VERBOSE=1
