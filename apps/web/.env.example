# Browser → API 根 URL（无尾斜杠）。改后须 rebuild web 镜像（NEXT_PUBLIC_* 在 build 时写入）。
#
# 宿主机 dev（pnpm dev:stack）：直连 FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Docker full profile：用 infra/docker/.env.deployment.local
#   NEXT_PUBLIC_API_URL=http://localhost:8080（Nginx 入口，build-arg 写入镜像）

# 仅 Docker full profile：BFF 服务端调 FastAPI（Compose 网络内 api:8000）
# 宿主机 dev 勿设；见 infra/docker/.env.deployment.example → API_UPSTREAM_URL
# API_UPSTREAM_URL=http://api:8000

# App display name (optional override)
# NEXT_PUBLIC_APP_NAME=MemoryOS

# Dev vitals: default alerts only "poor"; set 1 to include needs-improvement + all metrics in console
# NEXT_PUBLIC_WEB_VITALS_VERBOSE=1
