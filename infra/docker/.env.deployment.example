# MemoryOS deployment env — 同一套键，local / cloud 只换值
# 用法:
#   cp .env.deployment.example .env.deployment.local
#   docker compose --env-file .env.deployment.local --profile full up -d
#
# 上云: cp .env.deployment.example .env.deployment.cloud 后填 CLOUD 段

# --- 镜像（local 默认本地 tag；cloud 改为 registry）---
WEB_IMAGE=memoryos-web:local
API_IMAGE=memoryos-api:local
NGINX_HTTP_PORT=8080

# --- 浏览器访问 FastAPI 的对外根 URL（web 镜像 build 时 bake 进客户端；须与 NGINX 入口一致）---
# LOCAL:  Nginx 映射端口
# CLOUD:  https://your.domain
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Web BFF 服务端调 FastAPI（仅容器内；宿主机 dev 可不设）---
# LOCAL compose: http://api:8000
# CLOUD K8s: http://memoryos-api:8000 或集群内 Service DNS
API_UPSTREAM_URL=http://api:8000

# --- API（注入 api 容器；compose 内也可用下方默认值覆盖）---
# LOCAL:  @postgres / redis 服务名；CLOUD: 托管实例连接串
DATABASE_URL=postgresql+asyncpg://memoryos:memoryos@postgres:5432/memoryos
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LOCAL: Nginx 入口；CLOUD: https://your.domain
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

ENV=development
DEBUG=false
APP_NAME=MemoryOS API

# --- LLM LOCAL (Ollama) ---
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen3:8b
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_MODEL=mxbai-embed-large
EMBEDDING_DIMENSIONS=1024
# EMBEDDING_BASE_URL=  # task 6.1 后可与 OPENAI_BASE_URL 分离

# --- LLM CLOUD (百炼示例，上云时替换 LOCAL 段) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=qwen-turbo
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v4

RAG_CHAT_ENABLED=true
RAG_CHAT_TOP_K=5
RAG_CHAT_MIN_SCORE=0.35
RAG_CHAT_COLLECTION=

AGENT_TOOLS_ENABLED=true
AGENT_MAX_ITERATIONS=5
AGENT_TOOL_TIMEOUT_SECONDS=10
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=3

MEMORY_ENABLED=true
MEMORY_SHORT_TERM_ENABLED=true
MEMORY_LONG_TERM_ENABLED=true
MEMORY_LONG_TERM_TOP_K=5
MEMORY_MIN_SCORE=0.35
MEMORY_PRUNE_THRESHOLD=0.1
MAX_CONTEXT_TOKENS=8192
RESERVE_FOR_REPLY=1024
SUMMARY_TRIGGER_TOKENS=4096
SUMMARY_INCREMENT_TOKENS=1024
SUMMARY_COOLDOWN_SECONDS=300

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=memoryOS-dev
